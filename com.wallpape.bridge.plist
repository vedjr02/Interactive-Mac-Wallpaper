<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wallpape.bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/ved/wallpape/bridge.js</string>
  </array>

